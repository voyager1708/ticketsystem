# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# betawallet-dev の db を使う場合: docs/db-betawallet-dev.md を参照
SQL_HOST=host.docker.internal
SQL_PORT=5434
SQL_DATABASE=ticket_system
SQL_USER=yp_dev_user
SQL_PASSWORD=yp_dev_p@ssword


# Base API URL (betawallet-dev)
BASE_API_URL=http://localhost:8000

# Session Settings
SESSION_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:1338,https://localhost:5443

# Docker Settings
HOST_UID=1000
HOST_GID=1000
CONTAINER_USERNAME=app
NUM_WORKERS=5
