# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
# サーバのFQDN。設定すると ALLOWED_HOSTS に反映する（優先）。未設定時は ALLOWED_HOSTS を使用
# DOMAIN_NAME=ticket.example.com
# 複数可: DOMAIN_NAME=ticket.example.com,api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database（ハンズオンは SQLite で十分。PostgreSQL は本番や betawallet-dev 連携時に利用）
USE_SQLITE=True
# PostgreSQL を使う場合: USE_SQLITE を外し、以下を設定。betawallet-dev は docs/db-betawallet-dev.md 参照
# SQL_HOST=host.docker.internal
# SQL_PORT=5434
# SQL_DATABASE=ticket_system
# SQL_USER=yp_dev_user
# SQL_PASSWORD=yp_dev_p@ssword


# Base API URL (betawallet-dev)
BASE_API_URL=http://localhost:8000

# Session Settings
SESSION_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:1338,https://localhost:5443

# Docker Settings
HOST_UID=1000
HOST_GID=1000
CONTAINER_USERNAME=app
NUM_WORKERS=5
