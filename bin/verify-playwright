#!/usr/bin/env bash
# Docker 内で Playwright が利用可能か確認する。プロジェクトルートから実行すること。
set -euo pipefail
CALLED_FROM="${PWD}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [[ "${CALLED_FROM}" == "${SCRIPT_DIR}" ]]; then
  echo "Do not run from bin/. Run from project root:" >&2
  echo "  cd ${ROOT} && ./bin/$(basename "$0")" >&2
  exit 1
fi
cd "$ROOT"

COMPOSE_ARGS=(-f docker-compose.yml)
if [[ "${ROOT}" == *"ticketsystem-dev"* ]] || [[ "${ROOT}" == *"ticketsystem-start"* ]]; then
  COMPOSE_ARGS+=(-f docker-compose.dev.yml)
elif [[ "${ROOT}" == *"ticketsystem"* ]]; then
  COMPOSE_ARGS+=(-f docker-compose.prod.yml)
else
  echo "Current project path does not look like ticketsystem. Abort." >&2
  exit 1
fi

# 開発時は venv の Python を優先（exec では entrypoint が動かないため PATH をここで設定）
RUN_CMD='if [ -x /home/app/venv/bin/python ]; then export PATH=/home/app/venv/bin:$PATH; fi
python -c "
try:
    from playwright.sync_api import sync_playwright
    print(\"playwright: import OK\")
except ImportError as e:
    print(\"playwright: import FAIL\", e)
    exit(1)
with sync_playwright() as p:
    b = p.chromium.launch(headless=True, args=[\"--no-sandbox\"])
    print(\"chromium: launch OK\")
    b.close()
print(\"Playwright is ready for ticket image API.\")
"'

if docker compose "${COMPOSE_ARGS[@]}" ps -q ticket_web 2>/dev/null | grep -q .; then
  exec docker compose "${COMPOSE_ARGS[@]}" exec ticket_web sh -c "$RUN_CMD"
else
  exec docker compose "${COMPOSE_ARGS[@]}" run --rm --entrypoint "" ticket_web sh -c "$RUN_CMD"
fi
